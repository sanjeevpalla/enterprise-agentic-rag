# deepeval settings for `deepeval test run` / pytest, where deepeval's pytest plugin is imported
# before evaluation/__init__.py can set them (run_eval.py doesn't need this file):
#   uv run --group eval --env-file evaluation/deepeval.env deepeval test run evaluation/test_rag.py
# Same values and reasons as in evaluation/__init__.py.
ENV_DIR_PATH=evaluation
DEEPEVAL_TELEMETRY_OPT_OUT=YES
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=90
