# Copy to .env and fill in the keys you need: cp .env.example .env
# Never commit .env. Values left empty use the defaults shown in the comments.

# Settings for app/config/config.py (see README: Configuration).

# Embeddings. Changing provider or model needs a new QDRANT_COLLECTION.
# fastembed = local open-source model (no key, no rate limits); gemini = Google API.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_BATCH_SIZE=  # default: 32
EMBEDDING_CACHE_DIR=  # default: .cache/fastembed
EMBEDDING_THREADS=  # default: None
EMBEDDING_DOCUMENT_PREFIX=  # default: None
EMBEDDING_QUERY_PREFIX=  # default: None

# Gemini embeddings only (EMBEDDING_PROVIDER=gemini): 768, 1536 or 3072.
EMBEDDING_DIMENSIONS=768

# Qdrant. Leave QDRANT_URL empty to use an embedded on-disk store at QDRANT_PATH.
QDRANT_URL=  # e.g. https://<cluster-id>.<region>.cloud.qdrant.io:6333; empty = embedded store at QDRANT_PATH
QDRANT_API_KEY=  # Qdrant Cloud API key (not needed for the embedded store)
QDRANT_PATH=qdrant_data
QDRANT_COLLECTION=enterprise_agentic_rag
QDRANT_TIMEOUT=  # default: 60

# Search mode, used by ingestion and retrieval: hybrid (dense + BM25) or dense.
# Changing it needs a new QDRANT_COLLECTION.
RETRIEVAL_MODE=  # default: hybrid
SPARSE_MODEL=  # default: Qdrant/bm25

# Ingestion: chunking, local chunk JSON and the ingestion ledger.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
PROCESSED_DATA_DIR=processed_data
LEDGER_PATH=  # default: processed_data/ingestion_ledger.db

# Retrieval: fetch RETRIEVAL_FETCH_K candidates, rerank, return RETRIEVAL_TOP_K.
RETRIEVAL_TOP_K=  # default: 5
RETRIEVAL_FETCH_K=  # default: 20
RETRIEVAL_SCORE_THRESHOLD=  # default: None
RERANK_ENABLED=  # default: True
RERANK_MODEL=  # default: jinaai/jina-reranker-v1-turbo-en

# Agent LLM: answers and query rewriting.
# LLM_PROVIDER=gemini calls Google directly (GOOGLE_API_KEY; GEMINI_API_KEY also works).
# LLM_PROVIDER=portkey routes through the Portkey gateway (PORTKEY_API_KEY); LLM_MODEL and
# PLANNER_MODEL are then Model Catalog slugs, e.g. @google-prod/gemini-3.5-flash.
# GOOGLE_API_KEY is also used for embeddings when EMBEDDING_PROVIDER=gemini.
LLM_PROVIDER=portkey  # default: gemini
PORTKEY_API_KEY=  # required for LLM_PROVIDER=portkey
PORTKEY_BASE_URL=  # default: https://api.portkey.ai/v1
PORTKEY_CONFIG=  # saved config id (pc-...) or inline JSON (fallbacks, retries, cache); see README
GROQ_SLUG=  # Portkey Model Catalog slug (no @) for openai/gpt-oss-120b; enables the built-in Groq fallback config when PORTKEY_CONFIG is empty
GROQ_SLUG_2=  # slug for the fallback openai/gpt-oss-20b; default: GROQ_SLUG
GOOGLE_API_KEY=  # required for LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini (GEMINI_API_KEY also works)
LLM_MODEL=@groq/openai/gpt-oss-120b  # default: gemini-3.5-flash; with a saved PORTKEY_CONFIG the config's targets decide the model
LLM_TEMPERATURE=0  # default: None
LLM_TIMEOUT=  # default: 60
LLM_MAX_RETRIES=  # default: 2
AGENT_HISTORY_MESSAGES=  # default: 6
MEMORY_DB_PATH=  # default: memory_data/memory.sqlite (conversation memory + recent chats)
EVAL_RESULTS_DIR=  # default: evaluation/results (deepeval reports shown in the UI's Evaluation view)

# Planner: jev (TypeSafe Jev decision model) or llm (Gemini; PLANNER_MODEL, default LLM_MODEL).
PLANNER_PROVIDER=llm  # default: jev
TYPESAFE_API_KEY=  # required for PLANNER_PROVIDER=jev
TYPESAFE_BASE_URL=  # default: https://api.typesafe.ai
JEV_MODEL=  # default: jev-latest
JEV_TIMEOUT=  # default: 10.0
JEV_MAX_RETRIES=  # default: 2
PLANNER_MIN_CONFIDENCE=  # default: 0.6
PLANNER_MODEL=  # default: None

# Guardrails (Guardrails AI, run locally): input / retrieval / output checks.
GUARDRAILS_ENABLED=  # default: true
GROUNDING_CHECK_ENABLED=  # default: true (removes answer statements the sources do not support)
GUARDRAILS_INJECTION_PATTERNS=  # default: true (rule-based prompt-injection check)
GUARDRAILS_JAILBREAK_MODEL=  # default: false (DetectJailbreak ML model; gave no signal in testing)
GUARDRAILS_JAILBREAK_THRESHOLD=  # default: 0.81
GUARDRAILS_TOXICITY_THRESHOLD=  # default: 0.5
GUARDRAILS_PII_ENTITIES=  # default: ["EMAIL_ADDRESS","PHONE_NUMBER","CREDIT_CARD","US_SSN","IBAN_CODE"] (JSON list)
RETRIEVAL_MIN_RERANK_SCORE=  # default: -2.0 (drop chunks below this rerank score)

# Langfuse observability (tracing is off unless both keys are set).
# LANGFUSE_SAMPLE_RATE: fraction of files traced (lower it for very large runs, e.g. 0.05).
LANGFUSE_PUBLIC_KEY=  # pk-lf-...
LANGFUSE_SECRET_KEY=  # sk-lf-...
LANGFUSE_BASE_URL=  # default: https://cloud.langfuse.com (US region: https://us.cloud.langfuse.com)
LANGFUSE_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0

# Application logging. Console (stdout) always; files in LOG_DIR when LOG_TO_FILE=true
# (app.log = all, error.log = WARNING+). LOG_FORMAT: text or json.
# On AWS: LOG_TO_FILE=false and LOG_FORMAT=json, since stdout goes to CloudWatch Logs.
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
